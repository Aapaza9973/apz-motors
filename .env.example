APP_NAME=APZ Motor's
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/La_Paz
APP_CURRENCY=Bs

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apz_motors
DB_USERNAME=root
DB_PASSWORD=

# Respaldo diario (Documento Maestro §6): rutas de mysqldump/gzip para el VPS
# y destinatario de la notificación (éxito/fallo). Vacío = primer usuario Admin.
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_GZIP_PATH=gzip
BACKUP_NOTIFY_EMAIL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@apzmotors.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (Fase 2 - pagos en línea)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal (Fase 2 - pagos en línea)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# Notificación al taller por WhatsApp/push cuando llega un pedido del catálogo.
# Sin WHATSAPP_ENABLED=true el aviso queda en el log (modo seguro); la campana
# interna del panel siempre funciona. Payload enviado: {"to","text","token"}.
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TOKEN=
NOTIFY_TALLER_PHONE=
